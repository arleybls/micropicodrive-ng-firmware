build
tools/__pycache__/

# Local-only reference docs (owner's working notes) — deliberately untracked.
# Publish the developer reference and owner's manual.
docs/*
!docs/BLE_PROTOCOL.md
!docs/USER_MANUAL.md
!docs/USER_MANUAL.pdf
!docs/FIRMWARE_MANUAL.pdf
!docs/HARDWARE_INSTALLATION_MANUAL.pdf
!docs/images/
!docs/images/assembly/
!docs/images/assembly/*.png
!docs/images/assembly/*.jpg

# Build artefacts. Releases are published via GitHub Releases, not committed.
dist/

# Runtime device state written by the firmware, not source
CONFIG.CFG

# Device install / update scripts: local only, not published
tools/install_lite.ps1
tools/reinstall_lite.ps1
tools/install_p4.ps1
tools/ota_bletest.py
tools/publish_release.ps1

# Boot-animation source assets and converters: local only
/images/

# Duck-vote boards (session working material, mirrored to a Claude artifact)
ducks/

# Local History extension snapshots (can contain copies of excluded files)
.history/

# Editor config: the Pico extension generates it and pins local tool versions.
# Recommended extensions are documented in README.md instead.
.vscode/
